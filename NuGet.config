<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Offline, read-only package reuse.

    The machine-wide NuGet configuration enables source mapping with source names that the
    sibling AvaloniaFluentUI checkout expects. This project instead exposes exactly one empty
    local source and reuses the already populated global package cache at
    F:\nuget\.nuget\packages. All package versions required by M1 are already present there;
    restore therefore performs no network request and does not need to add packages to the
    cache. If a package is missing, restore must fail with NU1101 instead of silently
    downloading or writing outside HIS.Portal.
  -->
  <packageSources>
    <clear />
    <add key="offline-empty" value=".nuget-empty-feed" />
  </packageSources>

  <config>
    <add key="globalPackagesFolder" value="F:\nuget\.nuget\packages" />
    <add key="signatureValidationMode" value="accept" />
  </config>

  <packageSourceMapping>
    <clear />
    <packageSource key="offline-empty">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>
</configuration>
